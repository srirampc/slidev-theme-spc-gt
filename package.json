{
  "name": "slidev-theme-spc-gt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=18.0.0",
    "slidev": ">=v0.47.0"
  },
  "scripts": {
    "build": "slidev build example/slides.md",
    "dev": "slidev example/slides.md --open",
    "export": "slidev export example/slides.md",
    "screenshot": "slidev export example/slides.md --format png"
  },
  "dependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/openmoji": "^1.2.31",
    "@iconify-json/twemoji": "^1.2.5",
    "@iconify/vue": "^5.0.5",
    "@slidev/types": "^52.20.1"
  },
  "devDependencies": {
    "@slidev/cli": "^52.20.1",
    "playwright-chromium": "^1.65.1",
    "prettier": "^3.10.1"
  },
  "//": "Learn more: https://sli.dev/themes/write-a-theme.html",
  "slidev": {
    "colorSchema": "light",
    "highlighter": "shiki",
    "defaults": {
      "transition": "slide-left",
      "fonts": {
        "sans": "Roboto",
        "mono": "Fira Mono"
      }
    }
  }
}
